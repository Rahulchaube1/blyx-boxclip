use boxclip;

fn main() {
    let box = [-2, -1, 4, 6];
    let width = 3.0;
    let height = 4.0;
    let result = boxclip_inside(box, width, height);
    if len(result) == 0 { println!("invalid"); return; }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
